# Copy to backend/.env for local `supabase functions serve` use. Do not commit the copy.
# In hosted Supabase Edge Functions, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied
# by the platform; FIREBASE_SERVICE_ACCOUNT must be configured as a project secret.
SUPABASE_URL=https://sepvcatdqrnzjuvxabzh.supabase.co
SUPABASE_ANON_KEY=replace-with-the-Agora-Backup-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-Agora-Backup-service-role-key
WEBHOOK_SECRET=replace-with-a-high-entropy-shared-webhook-secret

# 🔐 FIREBASE_SERVICE_ACCOUNT — the service-account JSON on ONE line.
#
#   * Paste/download the JSON exactly as Firebase issues it; keep the "\n"
#     escapes inside private_key (they must stay two characters: backslash + n).
#   * Do NOT pretty-print it, do NOT wrap it in extra quotes, do NOT base64 it
#     (the loader tolerates those shapes, but they are a symptom of a broken
#     copy step and hide real truncation).
#   * The key must belong to project "agora-application".
#
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"agora-application","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@agora-application.iam.gserviceaccount.com",...}
#
# Verify it before deploying:
#   deno run --allow-env --allow-read backend/scripts/check-firebase-service-account.ts --env-file backend/.env
#   deno run --allow-env --allow-net --allow-read backend/scripts/check-firebase-service-account.ts --env-file backend/.env --live
#
# See docs/notification-pipeline.md for the full rotation runbook.
FIREBASE_SERVICE_ACCOUNT=replace-with-one-line-Firebase-service-account-JSON
