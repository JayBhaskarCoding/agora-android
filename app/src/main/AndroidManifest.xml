<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        ✦ PRODUCTION MANIFEST NOTES
        - applicationId AND Kotlin namespace are both net.agora.app (see
          app/build.gradle.kts and docs/engineering-notes.md §9). Components
          still use RELATIVE class names (".MainActivity"), which resolve
          against the namespace by construction.
        - Any future authority (FileProvider, permission) is written as
          "${applicationId}..." so it follows the id automatically.
        - Public web origin is agora.in.net (App Links + Supabase redirects).
          It is intentionally independent of the applicationId.
        - auth-agora.info / .online, com.example.agora and net.in.agora are all
          RETIRED as APP IDENTITIES: only agora.in.net is a public origin and
          only net.agora.app is the app identity (namespace AND applicationId,
          docs §17). Old web links are redirected (301) at the domain level,
          not routed by the app.
        - `net.in.agora://` survives ONLY as an accepted INBOUND custom scheme
          (see the custom-scheme filter below) so links and notifications
          minted by builds that shipped under the old applicationId still
          open the app instead of dead-ending. The app never emits it.
        - exported: MainActivity is the only launcher/deep-link entry point and is
          exported on purpose; the FCM service is exported="false" because only
          Google Play Services may bind to it.
    -->
    <application
        android:name=".AgoraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false">

        <!-- 🌟 FCM fallback presentation. The backend sends a top-level
             `notification` block, and when the app is BACKGROUNDED FCM renders
             that notification itself — PushNotificationService (and therefore
             setSmallIcon) never runs. Without these two values the tray icon is
             the launcher icon: an adaptive icon becomes a white square on
             Android 8+. These are ordinary (non-adaptive) drawables on purpose.
             When the app is foregrounded, PushNotificationService builds the
             notification and overrides both with the same values. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/agora_brand" />

        <!-- Launcher + deep links. Exported by necessity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ═══════════════════════════════════════════════════════════
                 CUSTOM-SCHEME FILTER — Supabase Auth callbacks (email OTP,
                 magic link, password recovery) and in-app notifications.

                 THREE schemes are accepted:

                   `agora`         — what the app emits for its own links
                                     (FCM payloads, notification intents,
                                     NavHost deep links, every share link).
                                     Stable since the first release.
                   `net.agora.app` — the applicationId. `intent://` URIs and
                                     anything derived from the package name
                                     (Supabase templates, ad SDKs, QR codes
                                     generated from the package) use this form.
                   `net.in.agora`  — LEGACY INBOUND ONLY. Builds up to and
                                     including the identity unification shipped
                                     under this applicationId, so links and
                                     notifications they minted use it. The app
                                     must keep accepting those or millions of
                                     already-delivered notifications would
                                     dead-end. Nothing emits it any more.

                 Whatever scheme is used MUST appear in the Supabase dashboard →
                 Authentication → URL Configuration → Redirect URLs;
                 backend/setup_agora_config.ps1 writes all of them.
                 ═══════════════════════════════════════════════════════════ -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agora" />
                <!-- The applicationId and namespace (one identity, docs §17).
                     intent:// URIs and anything built from the package name
                     use this form. -->
                <data android:scheme="net.agora.app" />
                <!-- LEGACY INBOUND ONLY: the applicationId of every build up to
                     the unification. Never emitted, only accepted, so
                     previously delivered links keep working. Safe to delete
                     once no such link can reach a user. -->
                <data android:scheme="net.in.agora" />
            </intent-filter>

            <!-- ═══════════════════════════════════════════════════════════
                 HTTPS APP LINKS — agora.in.net

                 One filter, one verified host, four path prefixes:
                   /post/...          shared post links + notification taps
                   /p/...             SHORT alias of the above (chats, QR
                                      codes, SMS — where every character of a
                                      link is visible or counted)
                   /auth-callback...  browser → app return path for
                   /login-callback... Supabase email / OAuth redirects when
                                      `redirect_to` is the production origin
                                      instead of the custom scheme.

                 ⚠️ autoVerify requires
                   https://agora.in.net/.well-known/assetlinks.json
                 to list `net.agora.app` — the applicationId — with the
                 SHA-256 of the certificate that signed the INSTALLED apk (Play
                 App Signing key for store builds). The file MUST be republished
                 when the applicationId changes: while it still names the old
                 package, Android silently opens the browser instead of the app.
                 Without it Android opens the browser instead of the app.

                 ⚠️ Exactly ONE host here. Domain verification is per-filter,
                 and on Android 8–11 a single unverifiable host in an
                 autoVerify filter un-verifies EVERY host in it — which is why
                 no retired or `www.` origin is declared anywhere in this file.
                 ═══════════════════════════════════════════════════════════ -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="agora.in.net"
                    android:pathPrefix="/post/" />
                <data
                    android:scheme="https"
                    android:host="agora.in.net"
                    android:pathPrefix="/p/" />
                <data
                    android:scheme="https"
                    android:host="agora.in.net"
                    android:pathPrefix="/auth-callback" />
                <data
                    android:scheme="https"
                    android:host="agora.in.net"
                    android:pathPrefix="/login-callback" />
            </intent-filter>
        </activity>

        <!-- 🌟 Firebase Cloud Messaging Push Notification Service.
             Not exported: it is bound by Google Play Services only, and the
             MESSAGING_EVENT intent filter must never be reachable by other apps. -->
        <service
            android:name=".service.PushNotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
