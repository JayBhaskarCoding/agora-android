<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        ✦ PRODUCTION MANIFEST NOTES
        - applicationId is net.in.agora (see app/build.gradle.kts); every
          component below is declared with a RELATIVE class name so it always
          resolves against the Kotlin namespace, independent of the app id.
        - Any future authority (FileProvider, permission) must be written as
          "${applicationId}..." so it follows the id automatically.
        - Public web origin is agora.in.net (App Links + Supabase redirects).
          It is intentionally independent of the applicationId.
        - exported: MainActivity is the only launcher/deep-link entry point and is
          exported on purpose; the FCM service is exported="false" because only
          Google Play Services may bind to it.
    -->
    <application
        android:name=".AgoraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false">

        <!-- Launcher + deep links. Exported by necessity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ═══════════════════════════════════════════════════════════
                 CUSTOM-SCHEME FILTER — Supabase Auth callbacks (email OTP,
                 magic link, password recovery) and in-app notifications.

                 TWO schemes are accepted, for one reason: `agora://` is what
                 the app already emits everywhere (FCM payloads, notification
                 intents, NavHost deep links, every link ever sent to a user),
                 while `net.in.agora://` is the applicationId-derived form some
                 Supabase templates use. Declaring both means neither an old
                 notification nor a new browser redirect dead-ends.

                 Whatever scheme is used MUST appear in the Supabase dashboard →
                 Authentication → URL Configuration → Redirect URLs;
                 backend/setup_agora_config.ps1 writes both.
                 ═══════════════════════════════════════════════════════════ -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agora" />
                <data android:scheme="net.in.agora" />
            </intent-filter>

            <!-- ═══════════════════════════════════════════════════════════
                 HTTPS APP LINKS — agora.in.net

                 One filter, one verified host, two path prefixes:
                   /post/...          shared post links + notification taps
                   /auth-callback...  browser → app return path for
                   /login-callback... Supabase email / OAuth redirects when
                                      `redirect_to` is the production origin
                                      instead of the custom scheme.

                 ⚠️ autoVerify requires
                   https://agora.in.net/.well-known/assetlinks.json
                 to list `net.in.agora` (the applicationId, NOT the Kotlin
                 namespace) with the SHA-256 of the certificate that signed the
                 INSTALLED apk (Play App Signing key for store builds).
                 Without it Android opens the browser instead of the app.
                 ═══════════════════════════════════════════════════════════ -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="agora.in.net"
                    android:pathPrefix="/post/" />
                <data
                    android:scheme="https"
                    android:host="agora.in.net"
                    android:pathPrefix="/auth-callback" />
                <data
                    android:scheme="https"
                    android:host="agora.in.net"
                    android:pathPrefix="/login-callback" />
            </intent-filter>
        </activity>

        <!-- 🌟 Firebase Cloud Messaging Push Notification Service.
             Not exported: it is bound by Google Play Services only, and the
             MESSAGING_EVENT intent filter must never be reachable by other apps. -->
        <service
            android:name=".service.PushNotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
