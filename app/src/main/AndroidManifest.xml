<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        ✦ PRODUCTION MANIFEST NOTES
        - applicationId is net.in.agora (see app/build.gradle.kts); every
          component below is declared with a RELATIVE class name so it always
          resolves against the Kotlin namespace, independent of the app id.
        - Any future authority (FileProvider, deep-link host, permission) must be
          written as "${applicationId}..." so it follows the id automatically.
        - exported: MainActivity is the only launcher/deep-link entry point and is
          exported on purpose; the FCM service is exported="false" because only
          Google Play Services may bind to it.
    -->
    <application
        android:name=".AgoraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false">

        <!-- Launcher + deep links. Exported by necessity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link Filter for Supabase Auth / Password Reset Callbacks -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="net.in.agora" />
            </intent-filter>

            <!-- App Links Filter for Post Deep Links (auth-agora.info) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="auth-agora.info"
                    android:pathPrefix="/post/" />
            </intent-filter>
        </activity>

        <!-- 🌟 Firebase Cloud Messaging Push Notification Service.
             Not exported: it is bound by Google Play Services only, and the
             MESSAGING_EVENT intent filter must never be reachable by other apps. -->
        <service
            android:name=".service.PushNotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
