<?xml version="1.0" encoding="utf-8"?>
<!-- ★ SPLASH — the Agora mark with a gold ring that spins once as it lands.
     Bound to windowSplashScreenAnimatedIcon in values/themes.xml (and its
     values-night twin), so it is the first thing drawn on both themes.

     Geometry: the indigo tile + white glyph below are copied VERBATIM from the
     launcher icon (ic_launcher_background / ic_launcher_foreground). Launching
     the app and tapping its icon must never show two different logos, so the
     mark is not redrawn here — only wrapped.

     Motion, in a single 800 ms beat that the OS splash screens play while the
     session resolves:
       • `gold`  — a 280° ring (the gap is what makes the rotation readable; a
                   closed circle would spin invisibly), scaling 0.75 -> 1.0 while
                   it turns 0 -> 360 degrees exactly once;
       • `mark`  — the logo settling 0.9 -> 1.0 slightly behind it.
     Both use fast_out_slow_in, so they accelerate off the mark and decelerate
     into place instead of stopping dead.

     aapt2 notes: the inner <vector> is supplied through <aapt:attr>, and each
     <target> names a group declared in it and points at an animator in
     res/animator/. Every property animated here (rotation, scaleX, scaleY) is
     an animatable <group> property — VectorDrawable has no group alpha, which is
     why the entrance is a scale rather than a fade. -->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <!-- Gold ring: r=86 around the centre (144,144), 280 degrees from
                 straight up, drawn clockwise with a round cap so the two ends
                 read as deliberate stops rather than a broken circle. -->
            <group
                android:name="gold"
                android:pivotX="144"
                android:pivotY="144">
                <path
                    android:name="gold_arc"
                    android:fillColor="#00000000"
                    android:strokeColor="#FFF5C542"
                    android:strokeWidth="7"
                    android:strokeLineCap="round"
                    android:pathData="M144,58 A86,86 0 1 1 59.3,129.1" />
            </group>

            <!-- The mark itself, wrapped only so it can scale about the centre. -->
