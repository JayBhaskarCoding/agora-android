<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup policy for Android 11 (API 30) and lower.
   Mirrors data_extraction_rules.xml — see that file for the reasoning.
   Excluded: auth session tokens, the single-device identity, and device-local
   verification grace state. Theme settings stay backed up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="agora_session.xml" />
    <exclude domain="sharedpref" path="agora_device.xml" />
    <exclude domain="sharedpref" path="agora_verification.xml" />
</full-backup-content>
