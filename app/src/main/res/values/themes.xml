<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base App Theme -->
    <style name="Theme.Agora" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 🌟 Native Splash Screen Theme (Light Mode: Pure White #FFFFFF) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/agora_splash</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Agora</item>
    </style>
</resources>
