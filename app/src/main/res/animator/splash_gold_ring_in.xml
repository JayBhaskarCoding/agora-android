<?xml version="1.0" encoding="utf-8"?>
<!-- ★ GOLD RING ENTRANCE — one full turn, arriving from 75% size.

     Rotation and scale share a duration so the ring does not finish turning
     before it has finished growing; the slow-in at the end is what makes the
     stop look intentional rather than abrupt.

     `valueType="floatType"` is required: without it the platform infers the
     type from the values and a 0 -> 360 rotation can be read as an integer,
     which drops the intermediate frames on some renderers. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">

    <objectAnimator
        android:propertyName="rotation"
        android:valueFrom="0"
        android:valueTo="360"
        android:valueType="floatType"
        android:duration="800"
        android:interpolator="@android:interpolator/fast_out_slow_in" />

    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0.75"
        android:valueTo="1.0"
        android:valueType="floatType"
        android:duration="800"
        android:interpolator="@android:interpolator/fast_out_slow_in" />

    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="0.75"
        android:valueTo="1.0"
        android:valueType="floatType"
        android:duration="800"
        android:interpolator="@android:interpolator/fast_out_slow_in" />

</set>
