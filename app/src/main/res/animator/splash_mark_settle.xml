<?xml version="1.0" encoding="utf-8"?>
<!-- ★ MARK SETTLE — the logo easing into its final size.

     Kept deliberately small (0.9 -> 1.0). The first frame of an animated vector
     is what the pre-Android-12 compat splash draws, so a large entrance scale
     would make the icon look shrunken on those devices for the whole cold start.
     This reads as the mark landing, and is unnoticeable if it never animates. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">

    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0.9"
        android:valueTo="1.0"
        android:valueType="floatType"
        android:duration="600"
        android:startOffset="120"
        android:interpolator="@android:interpolator/fast_out_slow_in" />

    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="0.9"
        android:valueTo="1.0"
        android:valueType="floatType"
        android:duration="600"
        android:startOffset="120"
        android:interpolator="@android:interpolator/fast_out_slow_in" />

</set>
