# Copy this file to local.properties. local.properties is intentionally ignored by Git.
# CI may instead provide these values as Gradle project properties (-PSUPABASE_URL=...).
SUPABASE_URL=https://sepvcatdqrnzjuvxabzh.supabase.co
SUPABASE_ANON_KEY=replace-with-the-Agora-Backup-anon-key

# Google Sign-In (Credential Manager) server client id — OAuth 2.0 client of
# type "Web application" from the SAME Google Cloud project as
# app/google-services.json (project number 1025610780303). An Android-type
# client id here fails with GetCredentialCancellationException right after the
# account picker. Optional: app/build.gradle.kts falls back to a documented
# default when this is absent.
GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Cloudinary signed deletion (optional).
# Required only so that deleting a post also destroys its photos/videos in
# Cloudinary. Without them the app still builds and deletes the database row;
# it logs a warning and the assets are left orphaned.
# Dashboard -> Settings -> API Keys: "API Key" and "API Secret".
#
# ⚠️ These end up in BuildConfig and therefore in the APK. Anyone can extract
#    them and call the destroy API on your whole account. Use a dedicated key
#    restricted to the "delete" action, or (better) proxy the call through a
#    Supabase Edge Function — see docs/engineering-notes.md §13.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
